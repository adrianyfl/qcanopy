if(NOT DEFINED GENERATOR OR NOT DEFINED TEST_ROOT)
  message(FATAL_ERROR "Missing test paths")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(root "${TEST_ROOT}/cli-${run_id}")
foreach(format ir qasm)
  execute_process(COMMAND "${GENERATOR}" --format ${format} --output "${root}/${format}" --qubits 2 --gates 15 --pairs 7 --prefix-group-size 3 --seed 18446744073709551615 RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0 OR NOT EXISTS "${root}/${format}/manifest.jsonl")
    message(FATAL_ERROR "CLI ${format} failed: ${output} ${error}")
  endif()
endforeach()
file(SHA256 "${root}/ir/manifest.jsonl" before)
execute_process(COMMAND "${GENERATOR}" --format ir --output "${root}/ir" RESULT_VARIABLE collision OUTPUT_QUIET ERROR_QUIET)
file(SHA256 "${root}/ir/manifest.jsonl" after)
if(collision EQUAL 0 OR NOT before STREQUAL after)
  message(FATAL_ERROR "Destination collision did not preserve output")
endif()
# Each case is encoded with commas to keep option/value pairs together in CMake lists.
set(bad_args "--format,bad" "--seed,-1" "--seed,18446744073709551616" "--seed,12x" "--qubits,0" "--qubits,33" "--pairs,0" "--pairs,18446744073709551615" "--gates,4294967295" "--prefix-fraction,nan" "--prefix-fraction,-0.1" "--equivalent-fraction,1.1" "--gate-set,bad" "--angle-mode,bad" "--prefix-group-size,0" "--verify,bad" "--unknown,x")
foreach(encoded IN LISTS bad_args)
  string(REPLACE "," ";" args "${encoded}")
  if(encoded MATCHES "^--format,")
    set(format_args "")
  else()
    set(format_args --format ir)
  endif()
  execute_process(COMMAND "${GENERATOR}" ${format_args} --output "${root}/invalid" ${args} RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
  if(result EQUAL 0 OR EXISTS "${root}/invalid")
    message(FATAL_ERROR "Accepted invalid arguments: ${encoded}")
  endif()
endforeach()
execute_process(COMMAND "${GENERATOR}" --output "${root}/missing-format" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "Accepted missing format")
endif()
execute_process(COMMAND "${GENERATOR}" --help RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "OpenQASM 3.0")
  message(FATAL_ERROR "Help failed")
endif()
message(STATUS "CLI outputs: ${root}")
