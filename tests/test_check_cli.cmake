# End-to-end exit-status test for `qcanopy check`. Run with -DQCANOPY=<binary> -DTEST_ROOT=<dir>.
if(NOT DEFINED QCANOPY OR NOT DEFINED TEST_ROOT)
  message(FATAL_ERROR "Missing test paths")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(root "${TEST_ROOT}/check-cli-${run_id}")
file(MAKE_DIRECTORY "${root}")

set(header "OPENQASM 3.0;\ninclude \"stdgates.inc\";\nqubit[2] q;\n")
file(WRITE "${root}/cx.qasm" "${header}cx q[0],q[1];\n")
file(WRITE "${root}/cx_flipped.qasm" "${header}h q[0];\nh q[1];\ncx q[1],q[0];\nh q[0];\nh q[1];\n")
file(WRITE "${root}/cz.qasm" "${header}cz q[0],q[1];\n")
file(WRITE "${root}/bad.qasm" "${header}frobnicate q[0];\n")
file(WRITE "${root}/one.qasm" "OPENQASM 3.0;\ninclude \"stdgates.inc\";\nqubit[1] q;\nh q[0];\n")

# Each case: expected exit status, then the arguments after `qcanopy`.
function(expect status)
  execute_process(COMMAND "${QCANOPY}" ${ARGN} WORKING_DIRECTORY "${root}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result STREQUAL "${status}")
    message(FATAL_ERROR "qcanopy ${ARGN}: expected exit ${status}, got ${result}\n${output}${error}")
  endif()
  set(last_output "${output}" PARENT_SCOPE)
  set(last_error "${error}" PARENT_SCOPE)
endfunction()

expect(0 check cx.qasm cx.qasm)
expect(0 check cx.qasm cx_flipped.qasm)
expect(0 check cx.qasm cx_flipped.qasm --no-rewrite --stimulus all-basis)
expect(1 check cx.qasm cz.qasm)
expect(1 check cx.qasm cz.qasm --quiet)
if(NOT last_output STREQUAL "")
  message(FATAL_ERROR "--quiet printed: ${last_output}")
endif()
expect(1 check cx.qasm cz.qasm --json)
if(NOT last_output MATCHES "\"equivalent\":false")
  message(FATAL_ERROR "--json output missing verdict: ${last_output}")
endif()

expect(2 check cx.qasm bad.qasm)
if(NOT last_error MATCHES "bad.qasm:[0-9]+:[0-9]+:")
  message(FATAL_ERROR "parse error not located: ${last_error}")
endif()
expect(2 check cx.qasm missing.qasm)
expect(2 check cx.qasm one.qasm)
expect(2 check cx.qasm)
expect(2 check cx.qasm cz.qasm --bogus)
expect(2)
expect(2 frobnicate)

expect(0 --help)
expect(0 check --help)
if(NOT last_output MATCHES "Exit status")
  message(FATAL_ERROR "check --help missing text: ${last_output}")
endif()
